# Copy this to .secrets.toml and fill in actual values.
# .secrets.toml is gitignored — NEVER commit secrets.

[development]
DATABASE_URL = "postgresql+asyncpg://postgres:postgres@localhost:54322/postgres"
DATABASE_URL_MIGRATE = "postgresql+asyncpg://postgres:postgres@localhost:54322/postgres"
SUPABASE_URL = "http://127.0.0.1:54321"
SUPABASE_ANON_KEY = "<from supabase start output>"
SUPABASE_JWT_SECRET = "<from supabase start output>"
SUPABASE_JWKS_URL = "http://127.0.0.1:54321/auth/v1/.well-known/jwks.json"

[testing]
DATABASE_URL = "postgresql+asyncpg://postgres:postgres@localhost:54322/cartwise_test"
DATABASE_URL_MIGRATE = "postgresql+asyncpg://postgres:postgres@localhost:54322/cartwise_test"
SUPABASE_URL = "http://test"
SUPABASE_ANON_KEY = "test-key"
SUPABASE_JWT_SECRET = "test-jwt-secret-at-least-32-characters-long"

[production]
DATABASE_URL = "postgresql+asyncpg://<user>:<password>@<host>:6543/postgres"
DATABASE_URL_MIGRATE = "postgresql+asyncpg://<user>:<password>@<host>:6543/postgres"
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY = "<from supabase dashboard>"
SUPABASE_JWT_SECRET = "<from supabase dashboard>"
SUPABASE_JWKS_URL = "https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
AI_API_KEY = "<if using cloud LLM>"
